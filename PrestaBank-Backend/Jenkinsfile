pipeline {
    agent any
    tools {
        maven "maven"  // Definir Maven instalado en Jenkins
    }
    stages {
        stage('Checkout Code') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/main']],
                    extensions: [],
                    userRemoteConfigs: [[url: 'https://github.com/neruiz3/Evaluacion_1']]
                )
            }
        }

        stage('Build Maven') {
            steps {
                dir('PrestaBank-Backend') {  // Bloque 'dir' dentro de 'steps'
                    bat 'mvn clean package'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('PrestaBank-Backend') {  // Ejecutar tests en el subdirectorio correcto
                    bat 'mvn test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('PrestaBank-Backend') {
                    bat 'docker build -t nerearuiz3/backend-image .'
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-credentials') {
                        bat 'docker login -u mtisw -p %dhpsw%'  // Login en Docker Hub
                    }
                    bat 'docker push nerearuiz3/backend-image'  // Subir la imagen
                }
            }
        }
    }
}